    {
      "name": "01 Crear dueño",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/duenos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"González\",\n  \"dni\": \"{{dni}}\",\n  \"telefono\": \"1145678901\",\n  \"email\": \"carlos.gonzalez@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const dueno = pm.response.json();",
              "pm.test(\"ID generado\", () => pm.expect(dueno.id).to.be.a(\"number\"));",
              "pm.collectionVariables.set(\"duenoId\", dueno.id);",
              "pm.test(\"DNI guardado\", () => pm.expect(dueno.dni).to.eql(pm.collectionVariables.get(\"dni\")));",
              "pm.test(\"Ubicación del recurso\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/duenos/\" + dueno.id));"
            ]
          }
        }
      ]
    },
