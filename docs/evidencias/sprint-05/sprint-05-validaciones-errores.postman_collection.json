{
  "info": {
    "_postman_id": "43f152b0-fecd-4f45-85ee-e205a6955481",
    "name": "VetSystem Sprint 05 - Validaciones y errores",
    "description": "Verifica Bean Validation, respuestas ErrorResponse y códigos HTTP 400, 404 y 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const futura = new Date();",
          "futura.setUTCDate(futura.getUTCDate() + 7);",
          "pm.collectionVariables.set('fechaFutura', futura.toISOString().slice(0, 10));",
          "const pasada = new Date();",
          "pasada.setUTCDate(pasada.getUTCDate() - 7);",
          "pm.collectionVariables.set('fechaPasada', pasada.toISOString().slice(0, 10));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test('La respuesta usa ErrorResponse', function () {",
          "        const error = pm.response.json();",
          "        pm.expect(error).to.have.all.keys('timestamp', 'status', 'error', 'mensaje', 'path');",
          "        pm.expect(error.status).to.eql(pm.response.code);",
          "        pm.expect(error.timestamp).to.be.a('string').and.not.empty;",
          "        pm.expect(error.error).to.be.a('string').and.not.empty;",
          "        pm.expect(error.mensaje).to.be.a('string').and.not.empty;",
          "        pm.expect(error.path).to.be.a('string').and.not.empty;",
          "    });",
          "}"
        ]
      }
    }
  ],
