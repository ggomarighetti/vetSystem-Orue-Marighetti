          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos Alberto\",\n  \"apellido\": \"González\",\n  \"telefono\": \"1199887766\",\n  \"email\": \"carlos.nuevo@example.com\",\n  \"dni\": \"11111111\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
