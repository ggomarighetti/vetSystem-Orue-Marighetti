  "item": [
    {
      "name": "01 Crear dueño con DTO",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/duenos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carlos\",\n  \"apellido\": \"González\",\n  \"dni\": \"28543210\",\n  \"telefono\": \"1145678901\",\n  \"email\": \"carlos.gonzalez@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const dueno = pm.response.json();",
              "pm.collectionVariables.set(\"duenoId\", dueno.id);",
              "pm.test(\"DuenoDTO sin mascotas\", () => { pm.expect(dueno.id).to.be.a(\"number\"); pm.expect(dueno.dni).to.eql(\"28543210\"); pm.expect(dueno).not.to.have.property(\"mascotas\"); });",
              "pm.test(\"Ubicación del dueño\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/duenos/\" + dueno.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Obtener dueño mediante DTO",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/duenos/{{duenoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta desacoplada de la entidad\", () => { const d = pm.response.json(); pm.expect(d.id).to.eql(Number(pm.collectionVariables.get(\"duenoId\"))); pm.expect(d).not.to.have.property(\"mascotas\"); });"
            ]
          }
        }
      ]
    },
