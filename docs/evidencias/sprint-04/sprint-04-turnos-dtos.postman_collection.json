      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Datos editables actualizados y DNI conservado\", () => { const d = pm.response.json(); pm.expect(d.nombre).to.eql(\"Carlos Alberto\"); pm.expect(d.telefono).to.eql(\"1199887766\"); pm.expect(d.dni).to.eql(\"28543210\"); });"
            ]
