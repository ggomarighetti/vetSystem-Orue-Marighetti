    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "duenoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "mascotaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "veterinarioId",
      "value": "",
